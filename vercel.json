    "sizes": [
      1200
    ],
    "qualities": [
      60
    ],
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "yybdncbgradywuiomyik.supabase.co",
        "pathname": "/storage/v1/object/public/**"
      }
    ]
  },
  "routes": [
    {
      "src": "^/$",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|TelegramBot|Twitterbot|LinkedInBot|Slackbot|Discordbot|SkypeUriPreview|Pinterest|redditbot|Embedly|Googlebot|bingbot).*"
        }
      ],
      "dest": "/api/og"
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "query",
          "key": "og"
        }
      ],
      "dest": "/api/og"
    },
    {
      "handle": "filesystem"
    }
  ]
}
